# ============================================================
# CAREERPILOT — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# Hack The Stack 2026
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gemini AI API Configuration (REQUIRED for Live AI Features)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Supabase Database Configuration (OPTIONAL — Fallback Memory DB works if empty)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
